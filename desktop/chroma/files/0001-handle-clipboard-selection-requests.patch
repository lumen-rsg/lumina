@@ -125,6 +130,17 @@ void SeatManager::connect() {
     wl_signal_add(&server_->cursor->events.swipe_end,
                   &on_cursor_swipe_end_);
 
+    // Data-device and primary-selection clients cannot update the seat's
+    // selections directly. The compositor must explicitly accept each valid
+    // request after wlroots has checked its serial.
+    on_request_set_selection_.notify = handle_request_set_selection;
+    wl_signal_add(&server_->seat->events.request_set_selection,
+                  &on_request_set_selection_);
+    on_request_set_primary_selection_.notify =
+        handle_request_set_primary_selection;
+    wl_signal_add(&server_->seat->events.request_set_primary_selection,
+                  &on_request_set_primary_selection_);
+
     wlr_xcursor_manager_load(server_->xcursor_mgr, 1.0f);
     wlr_cursor_set_xcursor(server_->cursor, server_->xcursor_mgr, "left_ptr");
 
@@ -132,6 +148,27 @@ void SeatManager::connect() {
     initialize_layout_state();
 }
 
+void SeatManager::handle_request_set_selection(
+    wl_listener* listener, void* data)
+{
+    SeatManager* self = wl_container_of(
+        listener, self, on_request_set_selection_);
+    auto* event = static_cast<wlr_seat_request_set_selection_event*>(data);
+    wlr_seat_set_selection(
+        self->server_->seat, event->source, event->serial);
+}
+
+void SeatManager::handle_request_set_primary_selection(
+    wl_listener* listener, void* data)
+{
+    SeatManager* self = wl_container_of(
+        listener, self, on_request_set_primary_selection_);
+    auto* event = static_cast<
+        wlr_seat_request_set_primary_selection_event*>(data);
+    wlr_seat_set_primary_selection(
+        self->server_->seat, event->source, event->serial);
+}
+
 xkb_keymap* SeatManager::build_keymap() const {
     const KeyboardConfig keyboard_config = effective_keyboard_config();
 
