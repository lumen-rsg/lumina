#!/usr/bin/python3
"""Lumina Assistant: one JSON request on stdin, one redacted JSON result.

Credentials never appear in argv, shell commands, QML config, or diagnostics.
Provider configuration is private to the user; chats are memory-only in QML.
"""
import json
import os
from pathlib import Path
import stat
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

MAX_INPUT = 1024 * 1024
MAX_RESPONSE = 4 * 1024 * 1024
PROVIDERS = {"openai-compatible", "anthropic", "gemini", "ollama"}
SYSTEM = "You are Lumina Assistant on Lumina 26.9 Cassiopeia, a Fedora 44 desktop using Chroma. Give clear, accurate help. Do not claim you have run commands or accessed the desktop. Explain effects before suggesting destructive commands."


class UserError(ValueError):
    """A safe, fixed diagnostic intended for the user."""


def config_path():
    return Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "lumina" / "assistant.json"


def read_config():
    path = config_path()
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return {}
    with os.fdopen(fd) as stream:
        mode = os.fstat(stream.fileno())
        if not stat.S_ISREG(mode.st_mode) or mode.st_uid != os.getuid() or mode.st_mode & 0o077:
            raise UserError("Assistant settings must be a private file owned by your user (mode 0600).")
        return json.load(stream)


def validate(config):
    if config.get("provider") not in PROVIDERS:
        raise UserError("Choose a supported provider.")
    if any(not isinstance(config.get(k, ""), str) or any(ord(c) < 32 for c in config.get(k, "")) for k in ("key", "model", "endpoint")):
        raise UserError("Provider settings must not contain control characters.")
    model = config.get("model", "")
    if not isinstance(model, str) or not model.strip() or len(model) > 200:
        raise UserError("Enter a valid model ID from your provider.")
    if config["provider"] in {"openai-compatible", "ollama"}:
        url = urllib.parse.urlsplit(config.get("endpoint", ""))
        if url.username or url.password or url.query or url.fragment or not url.hostname:
            raise UserError("Use a base URL without credentials, query parameters, or fragments.")
        local = url.hostname in {"localhost", "127.0.0.1", "::1"}
        if url.scheme != "https" and not (url.scheme == "http" and local):
            raise UserError("Use HTTPS, or HTTP on localhost for a local provider.")
    if config["provider"] != "ollama" and not config.get("key"):
        raise UserError("Enter an API key for this provider.")


def public_status(config):
    return {k: config.get(k, "") for k in ("provider", "model", "endpoint")} | {"configured": bool(config.get("provider"))}


def configure(request):
    previous = read_config()
    config = {k: request.get(k, "").strip() for k in ("provider", "model", "endpoint", "key")}
    config["endpoint"] = config["endpoint"].rstrip("/")
    if config["provider"] == "ollama" and not config["endpoint"]:
        config["endpoint"] = "http://localhost:11434"
    # Never carry a credential to a different provider or endpoint.
    if not config["key"] and all(config[k] == previous.get(k) for k in ("provider", "endpoint")):
        config["key"] = previous.get("key", "")
    validate(config)
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=".assistant-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(config, stream)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return public_status(config)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        # A configured provider must not forward its credential elsewhere.
        return None


def build_request(config, messages):
    validate(config)
    if not isinstance(messages, list) or not messages or len(messages) > 200:
        raise UserError("Start a new conversation; this one has reached its message limit.")
    if any(not isinstance(m, dict) or m.get("role") not in {"user", "assistant"} or not isinstance(m.get("content"), str) for m in messages):
        raise UserError("Invalid conversation.")
    messages = [{"role": m["role"], "content": m["content"]} for m in messages]
    provider, model = config["provider"], config["model"]
    headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if provider == "anthropic":
        url = "https://api.anthropic.com/v1/messages"
        headers.update({"x-api-key": config["key"], "anthropic-version": "2023-06-01"})
        body = {"model": model, "system": SYSTEM, "messages": messages, "max_tokens": 4096}
    elif provider == "gemini":
        url = "https://generativelanguage.googleapis.com/v1beta/models/" + urllib.parse.quote(model, safe="") + ":generateContent"
        headers["x-goog-api-key"] = config["key"]
        body = {"systemInstruction": {"parts": [{"text": SYSTEM}]}, "contents": [{"role": "model" if m["role"] == "assistant" else "user", "parts": [{"text": m["content"]}]} for m in messages]}
    else:
        url = config["endpoint"] + ("/api/chat" if provider == "ollama" else "/chat/completions")
        if config.get("key"):
            headers["Authorization"] = "Bearer " + config["key"]
        body = {"model": model, "messages": [{"role": "system", "content": SYSTEM}] + messages, "stream": False}
    return urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers, method="POST")


def chat(request):
    config = read_config()
    wire = build_request(config, request.get("messages"))
    with urllib.request.build_opener(NoRedirect).open(wire, timeout=90) as response:
        raw = response.read(MAX_RESPONSE + 1)
    if len(raw) > MAX_RESPONSE:
        raise UserError("The provider response was too large.")
    data = json.loads(raw)
    provider = config["provider"]
    if provider == "anthropic":
        content = "\n".join(part["text"] for part in data["content"] if part.get("type") == "text")
    elif provider == "gemini":
        content = "\n".join(part.get("text", "") for part in data["candidates"][0]["content"]["parts"])
    elif provider == "ollama":
        content = data["message"]["content"]
    else:
        content = data["choices"][0]["message"]["content"]
    if not isinstance(content, str) or not content.strip():
        raise UserError("The provider returned no text. Check its model and content settings.")
    return {"content": content}


def main():
    try:
        raw = sys.stdin.buffer.readline(MAX_INPUT + 1)
        if len(raw) > MAX_INPUT:
            raise UserError("Conversation too large; start a new conversation.")
        request = json.loads(raw)
        operation = request.get("operation")
        if operation == "status": result = public_status(read_config())
        elif operation == "configure": result = configure(request)
        elif operation == "chat": result = chat(request)
        else: raise UserError("Unknown assistant operation.")
    except urllib.error.HTTPError as error:
        result = {"error": f"Provider returned HTTP {error.code}. Check your model, key, and account limits."}
    except urllib.error.URLError:
        result = {"error": "Could not reach the provider. Check its URL and your connection."}
    except UserError as error:
        result = {"error": str(error)}
    except ValueError:
        result = {"error": "Invalid provider response or settings."}
    except Exception:
        result = {"error": "Assistant request failed. Check provider settings and try again."}
    print(json.dumps(result))


if __name__ == "__main__":
    main()
