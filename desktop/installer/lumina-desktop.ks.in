# Lumina 26.9 Cassiopeia network installer, generic UEFI @ARCH@.
# Disk selection, partitioning and account creation remain interactive.
graphical
lang en_US.UTF-8
keyboard --xlayouts=us
timezone Etc/UTC --utc
network --bootproto=dhcp --device=link --activate --onboot=yes --hostname=lumina
url --url=https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/@ARCH@/os/
repo --name=fedora-updates --baseurl=https://dl.fedoraproject.org/pub/fedora/linux/updates/44/Everything/@ARCH@/
repo --name=lumina-media --baseurl=file:///run/install/repo/LuminaPackages
# Leave account setup to Anaconda. A kickstarted rootpw --lock would incorrectly
# satisfy its administrator-account check even when no user exists.
selinux --enforcing
firewall --enabled
services --enabled=NetworkManager,ly@tty1,bluetooth,firewalld,chronyd --disabled=getty@tty1
firstboot --enable
reboot

%pre --erroronfail --log=/tmp/lumina-installer-identity.log
# The stage2 overlay is applied after systemd initially chooses a hostname.
python3 -c 'import socket; socket.sethostname("lumina")'
%end

%packages --exclude-weakdeps
@^lumina-desktop-environment
@core
kernel
kernel-modules
kernel-modules-extra
linux-firmware
# Fedora splits hardware firmware into weak dependencies. Select them explicitly
# because both the offline resolver and this transaction exclude weak deps.
amd-gpu-firmware
amd-ucode-firmware
atheros-firmware
brcmfmac-firmware
cirrus-audio-firmware
intel-audio-firmware
intel-gpu-firmware
iwlegacy-firmware
iwlwifi-dvm-firmware
iwlwifi-mvm-firmware
iwlwifi-mld-firmware
iwlbluetooth-firmware
mt7xxx-firmware
nvidia-gpu-firmware
nxpwireless-firmware
qcom-wwan-firmware
realtek-firmware
tiwilink-firmware
NetworkManager
NetworkManager-wifi
# Official Fedora 44 repository definitions and signing keys, bundled on media.
rpmfusion-free-release
rpmfusion-nonfree-release
# Keep hardware identification available even before networking is functional.
pciutils
usbutils
nautilus
gvfs
gnome-calculator
gnome-text-editor
file-roller
gnome-disk-utility
gnome-system-monitor
papers
mesa-dri-drivers
mesa-vulkan-drivers
dracut-config-generic
grubby
grub2-tools-extra
efibootmgr
@EFI_PACKAGES@
# Anaconda adds storage requirements after the user chooses a layout. Keep
# standard UEFI, NVMe, Btrfs/ext4/XFS, LUKS, LVM and MD RAID tools on offline media.
nvme-cli
btrfs-progs
dosfstools
e2fsprogs
xfsprogs
cryptsetup
lvm2
mdadm
langpacks-en
glibc-all-langpacks
lumina-desktop
chrony
firewalld
-initial-setup
-dolphin
%end

%post --erroronfail --log=/var/log/lumina-desktop-install.log
set -eu
usermod -L root
systemctl set-default graphical.target
systemctl mask getty@tty1.service
systemctl enable ly@tty1.service
# Avoid leaking the live installer's hostname into the new desktop.
if [ ! -s /etc/hostname ] || grep -Eq '^(fedora|localhost)(\.localdomain)?$' /etc/hostname; then
    echo lumina > /etc/hostname
fi
%end
