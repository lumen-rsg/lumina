set default="0"

function load_video {
    if [ x$feature_all_video_module = xy ]; then
        insmod all_video
    else
        insmod efi_gop
        insmod efi_uga
        insmod ieee1275_fb
    fi
}

load_video
set gfxpayload=keep
insmod gzio
insmod part_gpt
insmod ext2
set timeout=60

search --no-floppy --set=root -l 'Lumina-26-08-aarch64'

menuentry "Rescue installed 1T Lumina (SAFE - no disk erase)" {
    linux /images/pxeboot/vmlinuz selinux=0 inst.text inst.sshd inst.rescue console=tty0 inst.stage2=hd:LABEL=Lumina-26-08-aarch64 inst.repo=hd:LABEL=Lumina-26-08-aarch64:/LuminaPackages
    initrd /images/pxeboot/initrd.img
}

menuentry "Install 1T Lumina 26.08 to NVMe (ERASE nvme0n1)" {
    linux /images/pxeboot/vmlinuz selinux=0 inst.text inst.sshd console=tty0 inst.stage2=hd:LABEL=Lumina-26-08-aarch64 inst.repo=hd:LABEL=Lumina-26-08-aarch64:/LuminaPackages inst.ks=hd:LABEL=Lumina-26-08-aarch64:/jetson/lumina-jetson.ks lumina.jetson.target=nvme0n1 lumina.jetson.mode=fresh lumina.jetson.erase=YES
    initrd /images/pxeboot/initrd.img
}

menuentry "Install 1T Lumina 26.08 to eMMC (ERASE mmcblk0)" {
    linux /images/pxeboot/vmlinuz selinux=0 inst.text inst.sshd console=tty0 inst.stage2=hd:LABEL=Lumina-26-08-aarch64 inst.repo=hd:LABEL=Lumina-26-08-aarch64:/LuminaPackages inst.ks=hd:LABEL=Lumina-26-08-aarch64:/jetson/lumina-jetson.ks lumina.jetson.target=mmcblk0 lumina.jetson.mode=fresh lumina.jetson.erase=YES
    initrd /images/pxeboot/initrd.img
}

menuentry "Install 1T Lumina 26.08 to microSD (ERASE detected microSD)" {
    linux /images/pxeboot/vmlinuz selinux=0 inst.text inst.sshd console=tty0 inst.stage2=hd:LABEL=Lumina-26-08-aarch64 inst.repo=hd:LABEL=Lumina-26-08-aarch64:/LuminaPackages inst.ks=hd:LABEL=Lumina-26-08-aarch64:/jetson/lumina-jetson.ks lumina.jetson.target=microsd lumina.jetson.mode=fresh lumina.jetson.erase=YES
    initrd /images/pxeboot/initrd.img
}

menuentry "Install 1T Lumina 26.08 to USB (ERASE the only non-installer USB disk)" {
    linux /images/pxeboot/vmlinuz selinux=0 inst.text inst.sshd console=tty0 inst.stage2=hd:LABEL=Lumina-26-08-aarch64 inst.repo=hd:LABEL=Lumina-26-08-aarch64:/LuminaPackages inst.ks=hd:LABEL=Lumina-26-08-aarch64:/jetson/lumina-jetson.ks lumina.jetson.target=usb lumina.jetson.mode=fresh lumina.jetson.erase=YES
    initrd /images/pxeboot/initrd.img
}
