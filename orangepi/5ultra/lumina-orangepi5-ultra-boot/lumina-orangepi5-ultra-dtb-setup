#!/usr/bin/env bash

set -euo pipefail

die()
{
    printf 'lumina-orangepi5-ultra-dtb-setup: %s\n' "$*" >&2
    exit 1
}

kernel_version="${1:-}"
if [[ -z "${kernel_version}" ]]; then
    kernel_version="$({
        find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null || :
    } | sort -V | tail -n 1)"
fi
[[ -n "${kernel_version}" ]] || die 'no installed kernel was found'

readonly base_dtb="/usr/lib/modules/${kernel_version}/dtb/rockchip/rk3588-orangepi-5-ultra.dtb"
readonly output_dtb="/boot/lumina/rk3588-orangepi-5-ultra-${kernel_version}.dtb"
[[ -r "${base_dtb}" ]] || die "missing mainline DTB: ${base_dtb}"

install -d -m 0755 /boot/lumina
temporary_dtb="$(mktemp "${output_dtb}.XXXXXX")"
trap 'rm -f -- "${temporary_dtb}"' EXIT
install -m 0644 "${base_dtb}" "${temporary_dtb}"

gpio2_phandle="$(fdtget -tx "${temporary_dtb}" /pinctrl/gpio@fec30000 phandle)"
pull_none_phandle="$(fdtget -tx "${temporary_dtb}" /pinctrl/pcfg-pull-none phandle)"
pull_up_phandle="$(fdtget -tx "${temporary_dtb}" /pinctrl/pcfg-pull-up phandle)"

if [[ "$(fdtget -ts "${temporary_dtb}" /mmc@fe2d0000 status 2>/dev/null || :)" != okay ]] ||
   ! fdtget -ts "${temporary_dtb}" /mmc@fe2d0000/wifi@1 compatible 2>/dev/null |
       grep -Fqw brcm,bcm43752-fmac; then
    readonly pwrseq_phandle=4c550001
    readonly enable_phandle=4c550002
    readonly wake_phandle=4c550003
    readonly sdio_pins_phandle=4c550004

    if dtc -I dtb -O dts "${temporary_dtb}" 2>/dev/null |
        grep -Eq 'phandle = <0x4c55000[1-4]>;'; then
        die 'reserved Lumina AP6611 phandle collides with the kernel DTB'
    fi

    rtc_phandle="$(fdtget -tx "${temporary_dtb}" /i2c@fec80000/rtc@51 phandle)"
    gpio0_phandle="$(fdtget -tx "${temporary_dtb}" /pinctrl/gpio@fd8a0000 phandle)"
    pull_down_phandle="$(fdtget -tx "${temporary_dtb}" /pinctrl/pcfg-pull-down phandle)"

    fdtput -cp "${temporary_dtb}" \
        /lumina-ap6611-pwrseq \
        /pinctrl/lumina-sdio/sdiom0-pins \
        /pinctrl/lumina-wireless-wlan/wifi-enable-h \
        /pinctrl/lumina-wireless-wlan/wifi-host-wake-irq \
        /mmc@fe2d0000/wifi@1

    fdtput -ts "${temporary_dtb}" /lumina-ap6611-pwrseq compatible mmc-pwrseq-simple
    fdtput -tx "${temporary_dtb}" /lumina-ap6611-pwrseq phandle "${pwrseq_phandle}"
    fdtput -tx "${temporary_dtb}" /lumina-ap6611-pwrseq clocks "${rtc_phandle}"
    fdtput -ts "${temporary_dtb}" /lumina-ap6611-pwrseq clock-names ext_clock
    fdtput -ts "${temporary_dtb}" /lumina-ap6611-pwrseq pinctrl-names default
    fdtput -tx "${temporary_dtb}" /lumina-ap6611-pwrseq pinctrl-0 "${enable_phandle}"
    fdtput -tx "${temporary_dtb}" /lumina-ap6611-pwrseq post-power-on-delay-ms c8
    # With -tx, numeric cells are hexadecimal: GPIO2_C5 is pin 0x15.
    fdtput -tx "${temporary_dtb}" /lumina-ap6611-pwrseq reset-gpios \
        "${gpio2_phandle}" 15 1

    # Orange Pi's board DTS routes the soldered AP6611 through SDIO mux 0
    # on GPIO2. Mainline currently only describes mux 1 on GPIO3, whose
    # GPIO3_A5 clock pin is already owned by the Ultra's enabled SPI2 PMIC.
    fdtput -tx "${temporary_dtb}" \
        /pinctrl/lumina-sdio/sdiom0-pins phandle "${sdio_pins_phandle}"
    fdtput -tx "${temporary_dtb}" \
        /pinctrl/lumina-sdio/sdiom0-pins rockchip,pins \
        2 b 2 "${pull_none_phandle}" \
        2 a 2 "${pull_up_phandle}" \
        2 6 2 "${pull_up_phandle}" \
        2 7 2 "${pull_up_phandle}" \
        2 8 2 "${pull_up_phandle}" \
        2 9 2 "${pull_up_phandle}"

    fdtput -tx "${temporary_dtb}" \
        /pinctrl/lumina-wireless-wlan/wifi-enable-h phandle "${enable_phandle}"
    fdtput -tx "${temporary_dtb}" \
        /pinctrl/lumina-wireless-wlan/wifi-enable-h rockchip,pins \
        2 15 0 "${pull_none_phandle}"
    fdtput -tx "${temporary_dtb}" \
        /pinctrl/lumina-wireless-wlan/wifi-host-wake-irq phandle "${wake_phandle}"
    fdtput -tx "${temporary_dtb}" \
        /pinctrl/lumina-wireless-wlan/wifi-host-wake-irq rockchip,pins \
        0 8 0 "${pull_down_phandle}"

    fdtput -ts "${temporary_dtb}" /mmc@fe2d0000 status okay
    fdtput -tx "${temporary_dtb}" /mmc@fe2d0000 max-frequency 8f0d180
    fdtput "${temporary_dtb}" /mmc@fe2d0000 no-sd
    fdtput "${temporary_dtb}" /mmc@fe2d0000 no-mmc
    fdtput -tx "${temporary_dtb}" /mmc@fe2d0000 bus-width 4
    fdtput "${temporary_dtb}" /mmc@fe2d0000 disable-wp
    fdtput "${temporary_dtb}" /mmc@fe2d0000 cap-sd-highspeed
    fdtput "${temporary_dtb}" /mmc@fe2d0000 cap-sdio-irq
    fdtput "${temporary_dtb}" /mmc@fe2d0000 keep-power-in-suspend
    fdtput "${temporary_dtb}" /mmc@fe2d0000 non-removable
    fdtput "${temporary_dtb}" /mmc@fe2d0000 sd-uhs-sdr104
    fdtput -tx "${temporary_dtb}" /mmc@fe2d0000 mmc-pwrseq "${pwrseq_phandle}"
    fdtput -ts "${temporary_dtb}" /mmc@fe2d0000 pinctrl-names default
    fdtput -tx "${temporary_dtb}" /mmc@fe2d0000 pinctrl-0 "${sdio_pins_phandle}"
    fdtput -tx "${temporary_dtb}" /mmc@fe2d0000 '#address-cells' 1
    fdtput -tx "${temporary_dtb}" /mmc@fe2d0000 '#size-cells' 0

    fdtput -ts "${temporary_dtb}" /mmc@fe2d0000/wifi@1 compatible \
        brcm,bcm43752-fmac brcm,bcm4329-fmac
    fdtput -tx "${temporary_dtb}" /mmc@fe2d0000/wifi@1 reg 1
    fdtput -tx "${temporary_dtb}" /mmc@fe2d0000/wifi@1 interrupt-parent \
        "${gpio0_phandle}"
    fdtput -tx "${temporary_dtb}" /mmc@fe2d0000/wifi@1 interrupts 8 4
    fdtput -ts "${temporary_dtb}" /mmc@fe2d0000/wifi@1 interrupt-names host-wake
    fdtput -ts "${temporary_dtb}" /mmc@fe2d0000/wifi@1 pinctrl-names default
    fdtput -tx "${temporary_dtb}" /mmc@fe2d0000/wifi@1 pinctrl-0 "${wake_phandle}"
fi

# The legacy root rfkill node reuses GPIO0_C4, which is already the RTC IRQ.
# Bluetooth is controlled by its UART transport and Wi-Fi by the MMC pwrseq.
if fdtget -p "${temporary_dtb}" /rfkill >/dev/null 2>&1; then
    fdtput -ts "${temporary_dtb}" /rfkill status disabled
fi

[[ "$(fdtget -ts "${temporary_dtb}" / model)" == 'Xunlong Orange Pi 5 Ultra' ]] ||
    die 'board model changed while generating the merged DTB'
[[ "$(fdtget -ts "${temporary_dtb}" /mmc@fe2d0000 status)" == okay ]] ||
    die 'SDIO controller is not enabled in the merged DTB'
fdtget -ts "${temporary_dtb}" /mmc@fe2d0000/wifi@1 compatible |
    grep -Fqw brcm,bcm43752-fmac || die 'AP6611 brcmfmac binding is missing'
expected_sdio_pins_phandle="$(
    fdtget -tx "${temporary_dtb}" /pinctrl/lumina-sdio/sdiom0-pins phandle 2>/dev/null ||
        fdtget -tx "${temporary_dtb}" /pinctrl/sdio/sdiom0-pins phandle
)"
active_sdio_pins="$(fdtget -tx "${temporary_dtb}" /mmc@fe2d0000 pinctrl-0)"
active_sdio_pins_phandle="${active_sdio_pins%% *}"
[[ "${active_sdio_pins_phandle}" == "${expected_sdio_pins_phandle}" ]] ||
    die 'AP6611 is not routed through the board SDIO mux 0 pins'
sdio_pin_cells="$(
    fdtget -tx "${temporary_dtb}" /pinctrl/lumina-sdio/sdiom0-pins rockchip,pins 2>/dev/null ||
        fdtget -tx "${temporary_dtb}" /pinctrl/sdio/sdiom0-pins rockchip,pins
)"
[[ "${sdio_pin_cells}" == \
    "2 b 2 ${pull_none_phandle} 2 a 2 ${pull_up_phandle} 2 6 2 ${pull_up_phandle} 2 7 2 ${pull_up_phandle} 2 8 2 ${pull_up_phandle} 2 9 2 ${pull_up_phandle}" ]] ||
    die 'AP6611 SDIO mux 0 pin cells do not match the Orange Pi 5 Ultra'
reset_gpio_cells="$(fdtget -tx "${temporary_dtb}" /lumina-ap6611-pwrseq reset-gpios)"
[[ "${reset_gpio_cells}" == "${gpio2_phandle} 15 1" ]] ||
    die 'AP6611 reset is not routed to GPIO2_C5 active-low'
enable_pin_cells="$(
    fdtget -tx "${temporary_dtb}" /pinctrl/lumina-wireless-wlan/wifi-enable-h rockchip,pins
)"
[[ "${enable_pin_cells}" == "2 15 0 ${pull_none_phandle}" ]] ||
    die 'AP6611 enable pinctrl is not routed to GPIO2_C5'

mv -f -- "${temporary_dtb}" "${output_dtb}"
trap - EXIT
printf 'Generated %s from Fedora kernel %s\n' "${output_dtb}" "${kernel_version}"
